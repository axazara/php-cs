{
    "name": "axazara/php-cs",
    "description": "Axa Zara PHP Code style configuration for `php-cs-fixer` based on PSR-12.",
    "type": "package",
    "license": "MIT",
    "keywords": [
        "php",
        "php-cs-fixer",
        "code-style"
    ],
    "homepage": "https://axazara.com",
    "authors": [
        {
            "name": "Axa Zara Core Dev"
        }
    ],
    "contributors": [
        {
            "name": "Elias Elimah"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "friendsofphp/php-cs-fixer": "^3.34"
    },
    "require-dev": {
        "phpunit/phpunit": "^9 || ^10",
        "phpstan/phpstan": "^1.10",
        "mockery/mockery": "^1.6",
        "insolita/unused-scanner": "^2.4",
        "spatie/ray": "^1.37"
    },
    "autoload": {
        "psr-4": {
            "AxaZara\\CS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "cp vendor/axazara/php-cs/.php-cs-fixer.dist.php .php-cs-fixer.dist.php"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "sniff": "vendor/bin/php-cs-fixer fix -vvv --dry-run --show-progress=dots",
        "format": "vendor/bin/php-cs-fixer fix -v",
        "test": [
            "vendor/bin/phpunit --no-coverage --color=always"
        ],
        "unused": "vendor/bin/unused_scanner unused-scanner.php"
    }
}
